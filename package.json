{
  "name": "dsh-memory-kit",
  "version": "0.1.4",
  "description": "分层记忆：core + topics + 实体别名 + 事实层。每轮只注入几百字，其余按需读。不做向量、不做自动摘要、不写云端。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  }
}
